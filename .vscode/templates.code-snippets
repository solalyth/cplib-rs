{
	"Initialize for AtCoder": {
		"scope": "rust",
		"prefix": "init",
		"body": "#![allow(unused_must_use, non_snake_case, unused_labels, unused_imports, non_upper_case_globals)]\nuse external::*;\nuse cplib::prelude::*;\nuse nest as vec;\nconst INTERACTIVE: bool = false;\n// const INTERACTIVE: bool = true; use input_interactive as input;\n#[allow(unused)] type Mint = ac_library::ModInt998244353;\n#[allow(unused)] macro_rules! fp { (\\$x:expr) => { Mint::new(\\$x) }; }\n\nfn solve() {\n\tinput! {\n\t\t$1\n\t}\n\t\n\t$0\n}\n\n\n\nfn main() {\n\tout::init(INTERACTIVE || LOCAL);\n\t// input! { T: usize } for _ in 0..T { solve(); }\n\tsolve();\n\tout::print();\n}\n"
	},
	
	"crate::epr": {
		"scope": "rust",
		"prefix": "epr",
		"body": "epr!(\"{$0}\");"
	},
	
	"LRUD match": {
		"scope": "rust",
		"prefix": "snp_match_lrud",
		"body": [
			"match $0 {",
			"\t'L' => {",
			"\t\t// x--, (-1, 0)",
			"\t}",
			"\t'R' => {",
			"\t\t// x++, (1, 0)",
			"\t}",
			"\t'U' => {",
			"\t\t// y++, (0, 1)",
			"\t}",
			"\t'D' => {",
			"\t\t// y--, (0, -1)",
			"\t}",
			"\t_ => { unreachable!() }",
			"}"
		]
	},
	
	"尺取り max-right": {
		"scope": "rust",
		"prefix": "snp_max_right",
		"description": "不足が判定できるとき",
		"body": [
			"let mut r = 0;",
			"for l in 0..${1:len} {",
			"\t// pred(r) = A[r] を追加すべきか",
			"\twhile r != ${1:len} && ${0:pred(r)} {",
			"\t\t// push_back(r);",
			"\t\tr += 1;",
			"\t}",
			"\t",
			"\t// ans[l] = r",
			"\t",
			"\tif l != r {",
			"\t\t// pop_front(l);",
			"\t} else {",
			"\t\tr += 1;",
			"\t}",
			"}",
		]
	},
	
	"尺取り min-left": {
		"scope": "rust",
		"prefix": "snp_min_left",
		"description": "超過が判定できるとき",
		"body": [
			"let mut l = 0;",
			"for r in 1..=${1:len} {",
			"\t// push_back(r-1);",
			"\t",
			"\t// pred(l) = A[l] を削除すべきか",
			"\twhile l != r && ${0:pred(l)} {",
			"\t\t// pop_front(l);",
			"\t\tl += 1;",
			"\t}",
			"\t",
			"\t// ans[r] = l",
			"}",
		]
	},
	
	"define new SegtreeOp": {
		"scope": "rust",
		"prefix": "snp_segtree",
		"body": [
			"struct ${1:Op};",
			"impl SegtreeOp for $1 {",
			"\ttype Value = $2;",
			"\ttype Lazy = ${3:()};",
			"\tfn id_value() -> Self::Value {",
			"\t\t$0",
			"\t}",
			"\tfn prod_value(l: &Self::Value, r: &Self::Value) -> Self::Value {",
			"\t\t",
			"\t}",
			"\tfn id_lazy() -> Self::Lazy {",
			"\t\t",
			"\t}",
			"\tfn act(value: &mut Self::Value, lazy: &Self::Lazy) {",
			"\t\t",
			"\t}",
			"\tfn prod_lazy(f: &mut Self::Lazy, ad: &Self::Lazy) {",
			"\t\t",
			"\t}",
			"}",
		]
	},
	
	"Warshall-Floyd": {
		"scope": "rust",
		"prefix": "snp_warshall_floyd",
		"body": [
			"macro_rules! upd {",
			"\t(\\$k:expr) => {",
			"\t\tlet k = \\$k;",
			"\t\tfor i in 0..N {",
			"\t\t\tfor j in 0..N {",
			"\t\t\t\tchmin!(E[i][j]; E[i][k] + E[k][j]);",
			"\t\t\t\tchmax!(E[i][j]; -1i64<<60);",
			"\t\t\t}",
			"\t\t}",
			"\t};",
			"}",
		]
	}
}
